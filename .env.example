# Local development: copy this file to .env at the repository root.
# .env is ignored by Git. Never put real credentials in this example.
# Run the API with --launch-profile http (Development, localhost:5051).
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pokerpoints;Username=pokerpoints;Password=pokerpoints

# Optional: seed a verified local administrator so SMTP is not needed.
# Set both values before the first startup. Existing passwords are not reset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jira Cloud OAuth 2.0 integration (resource-level access).
# Keep disabled until ClientId, ClientSecret, and an absolute KeyPath are set.
# Configure read:jira-work and write:jira-work in Atlassian's developer console.
# The application adds offline_access to its authorization URL automatically.
Jira__Enabled=false
Jira__ClientId=
Jira__ClientSecret=
# Register ONLY this backend callback in the Atlassian app's callback URLs.
Jira__CallbackUrl=http://localhost:5051/api/integrations/jira/callback
Jira__FrontendUrl=http://localhost:4200
# Set an absolute, persistent directory outside the repository. Create it first.
# Do not use ~ or $HOME here; put the full filesystem path instead.
Jira__KeyPath=

# Required outside Development: a PFX certificate protecting persisted keys.
Jira__CertificatePath=
Jira__CertificatePassword=
